# Copie para .env e preencha. Nunca envie o .env ao Git.
# Chave longa e aleatoria para entrar no painel (nao e o token da Meta).
APP_ADMIN_KEY=
# Token de acesso da Meta (usuario do sistema, permanente).
META_ACCESS_TOKEN=
# ID do numero de telefone na Cloud API (so digitos).
META_PHONE_NUMBER_ID=
# Versao da Graph API, no formato vN.N (ex.: v22.0).
META_GRAPH_VERSION=
# Senha que voce inventa; a mesma vai no painel da Meta ao cadastrar o webhook.
META_WEBHOOK_VERIFY_TOKEN=
# Chave secreta do app (Configuracoes do app > Basico).
META_APP_SECRET=
# Numero pessoal para testes, so digitos com DDI.
APP_TEST_RECIPIENT=
# ID da conta do WhatsApp Business; usado para listar modelos aprovados.
META_WABA_ID=
